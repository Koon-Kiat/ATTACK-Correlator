# Run python scripts/configure_env.py to create .env with random local secrets.
COMPOSE_PROJECT_NAME=attack-correlator
STACK_VERSION=9.5.3
ES_PORT=9200
KIBANA_PORT=5601
ES_MEMORY_LIMIT=2g
ES_JAVA_OPTS=-Xms1g -Xmx1g
KIBANA_MEMORY_LIMIT=2g
LOGSTASH_MEMORY_LIMIT=1g
LS_JAVA_OPTS=-Xms512m -Xmx512m
ELASTIC_PASSWORD=GENERATE_ME
KIBANA_PASSWORD=GENERATE_ME
KIBANA_ENCRYPTION_KEY=GENERATE_ME
KIBANA_SECURITY_KEY=GENERATE_ME
KIBANA_REPORTING_KEY=GENERATE_ME
