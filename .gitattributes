# These reports were generated with CRLF; do not normalize or trim their source output.
analysis/attack_coverage.csv -text whitespace=cr-at-eol
analysis/attack_coverage.md -text whitespace=cr-at-eol,-blank-at-eof
analysis/attack_evidence.json -text whitespace=cr-at-eol
analysis/dataset_inventory.md -text whitespace=cr-at-eol,-blank-at-eof
analysis/dataset_schema.json -text whitespace=cr-at-eol
analysis/ecs_mapping_candidates.md -text whitespace=cr-at-eol,-blank-at-eof
analysis/inventory-manifest.json -text whitespace=cr-at-eol
analysis/preprocessing_report.md whitespace=-blank-at-eof
